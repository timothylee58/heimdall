# Local unauthenticated loopback only. Cloud must use production/cloud-run-iam.
HEIMDALL_MODE=local
HEIMDALL_AUTH_MODE=local
PORT=8000
# DATABASE_URL is injected server-side from Secret Manager, never into a browser.
# Cloud SQL target: heimdall-515408 / asia-southeast1; instance is unresolved.
# Production template only; replace placeholders before use:
# HEIMDALL_MODE=production
# HEIMDALL_AUTH_MODE=cloud-run-iam
# INSTANCE_CONNECTION_NAME=heimdall-515408:asia-southeast1:[INSTANCE_ID]
# DATABASE_URL=postgresql://[RUNTIME_LOGIN]:[ENCODED_PASSWORD]@/[DATABASE_NAME]?host=/cloudsql/heimdall-515408:asia-southeast1:[INSTANCE_ID]&sslmode=disable
# Attach this exact instance to Cloud Run. Auth Proxy supplies remote TLS/IAM;
# sslmode=disable is allowed only on that local Unix socket, never on TCP.
# Runtime service account: cloudsql.client + secretAccessor on database secret.
# Runtime DB login: heimdall_runtime only; no cloudsqlsuperuser/owner privileges.
# Direct TCP alternative requires sslmode=verify-full and trusted sslrootcert.
